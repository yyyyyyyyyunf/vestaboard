{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "react", "react-perf", "unicorn", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "warn"
  },
  "ignorePatterns": ["dist", "demo/dist", "node_modules", "coverage"]
}
