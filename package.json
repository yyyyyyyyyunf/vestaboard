{
  "name": "@fly4react/vestaboard",
  "version": "0.1.0",
  "description": "React split-flap display component inspired by Vestaboard",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsc && vite build",
    "build:demo": "tsc && vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --ignore-pattern dist --ignore-pattern demo/dist --ignore-pattern node_modules --ignore-pattern coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "keywords": [
    "react",
    "split-flap",
    "vestaboard",
    "animation",
    "gsap"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyyyyyyyyunf/vestaboard.git"
  },
  "bugs": {
    "url": "https://github.com/yyyyyyyyyunf/vestaboard/issues"
  },
  "homepage": "https://github.com/yyyyyyyyyunf/vestaboard#readme",
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "commit-and-tag-version": "^12.7.3",
    "gsap": "^3.12.5",
    "jsdom": "^25.0.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^2.1.0"
  }
}
